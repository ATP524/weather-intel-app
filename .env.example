# Copy this file to .env for local development.
# In production on Databricks Apps, LAKEBASE_URL is injected from the
# "database-day2/lakebase-url" secret via app.yaml - do NOT put a real secret
# value in this file or commit a filled-in .env.

# --- Lakebase (Postgres + pgvector) ----------------------------------------
LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
LAKEBASE_SECRET_SCOPE=database-day2
LAKEBASE_SECRET_KEY=lakebase-url

# --- NWS weather API (api.weather.gov) -------------------------------------
# No API key: NWS is open. But it REQUIRES a descriptive User-Agent with a
# contact (email or app URL) or it returns HTTP 403. Put YOUR real contact here.
WEATHER_API_BASE_URL=https://api.weather.gov
WEATHER_USER_AGENT=(weather-lakebase-homework, your-email@example.com)

# Geocoder for turning free-text city names into coordinates (Open-Meteo; free,
# no API key). Only override to point at a mock/alternative during testing.
WEATHER_GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search

# Default locations harvested by /weather/sync when none are supplied in the
# request body. Semicolon-separated; each entry is any US city name (resolved
# via the geocoder) or a "lat,lon" pair.
WEATHER_LOCATIONS=Chicago, IL;Austin, TX;Miami, FL;Oklahoma City, OK

# --- Embeddings ------------------------------------------------------------
# MUST match the model used by notebooks/ingest_weather_embeddings.py, or query
# vectors won't be comparable to stored vectors. 384-dim pairs with vector(384).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
